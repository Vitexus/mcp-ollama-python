{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vitexsoftware/mcp-server-ollama",
  "title": "Ollama MCP Server",
  "description": "Expose local Ollama models to AI assistants as MCP tools.",
  "version": "1.1.0",
  "websiteUrl": "https://github.com/Vitexus/mcp-ollama-python",
  "repository": {
    "url": "https://github.com/Vitexus/mcp-ollama-python",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-server-ollama",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OLLAMA_HOST",
          "description": "Ollama server URL",
          "default": "http://127.0.0.1:11434"
        },
        {
          "name": "OLLAMA_API_KEY",
          "description": "API key for a remote or cloud Ollama endpoint",
          "isSecret": true
        },
        {
          "name": "OLLAMA_MODELS",
          "description": "Ollama models directory"
        },
        {
          "name": "OLLAMA_EXECUTE_ENABLED",
          "description": "Enable the opt-in ollama_execute tool",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "OLLAMA_ALLOW_REMOTE_HOST",
          "description": "Allow OLLAMA_HOST to point to a non-local server",
          "default": "false",
          "choices": [
            "true",
            "false"
          ]
        },
        {
          "name": "OLLAMA_READ_ONLY",
          "description": "Register only read-only tools (no pull, delete, execute)",
          "default": "false"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "cz.vitexsoftware.mcp": {
        "uuid": "8c2c3105-c951-4531-90a7-62218070ec12",
        "author": {
          "name": "Vítězslav Dvořák",
          "url": "https://github.com/VitexSoftware"
        },
        "tools": [
          {
            "name": "ollama_chat",
            "description": "Interactive chat with Ollama models. Supports multi-turn conversations, tool calling, and structured outputs.",
            "title": "Chat With Model",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the model to use for chat"
                },
                "messages": {
                  "type": "array",
                  "description": "Array of chat messages",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "system",
                          "user",
                          "assistant"
                        ]
                      },
                      "content": {
                        "type": "string"
                      },
                      "images": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "role",
                      "content"
                    ]
                  }
                },
                "tools": {
                  "type": "array",
                  "description": "Array of tools available to the model",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "function": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "parameters": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                },
                "options": {
                  "type": "object",
                  "description": "Generation options (temperature, top_p, etc.)",
                  "properties": {
                    "temperature": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "top_p": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "top_k": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "num_predict": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "repeat_penalty": {
                      "type": "number",
                      "minimum": 0
                    },
                    "seed": {
                      "type": "integer"
                    },
                    "stop": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model",
                "messages"
              ],
              "type": "object"
            }
          },
          {
            "name": "ollama_delete",
            "description": "Remove models from local Ollama storage to free up disk space. Destructive: the model must be pulled again to restore it.",
            "title": "Delete Model",
            "annotations": {
              "destructiveHint": true,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": false
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the model to delete"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model"
              ],
              "type": "object"
            }
          },
          {
            "name": "ollama_embed",
            "description": "Generate vector embeddings for text using Ollama's embedding models like nomic-embed-text.",
            "title": "Create Embeddings",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the embedding model (e.g., 'nomic-embed-text')"
                },
                "input": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Single text string to embed"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Array of text strings to embed"
                    }
                  ],
                  "description": "Text or array of texts to generate embeddings for"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model",
                "input"
              ],
              "type": "object"
            }
          },
          {
            "name": "ollama_execute",
            "description": "Execute code locally (opt-in: set OLLAMA_EXECUTE_ENABLED=1). Supports Python, JavaScript, TypeScript, Ruby, PHP, and Go. Shell/bash is not supported. Runs arbitrary code: user confirmation is expected.",
            "title": "Execute Code",
            "annotations": {
              "destructiveHint": true,
              "idempotentHint": false,
              "openWorldHint": true,
              "readOnlyHint": false
            },
            "inputSchema": {
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Code to execute (required if generate=false)"
                },
                "language": {
                  "type": "string",
                  "description": "Programming language (default: python)",
                  "enum": [
                    "go",
                    "javascript",
                    "php",
                    "python",
                    "ruby",
                    "typescript"
                  ],
                  "default": "python"
                },
                "generate": {
                  "type": "boolean",
                  "description": "Generate code using AI before executing (default: false)",
                  "default": false
                },
                "prompt": {
                  "type": "string",
                  "description": "Prompt for AI code generation (required if generate=true)"
                },
                "model": {
                  "type": "string",
                  "description": "Model to use for code generation (default: llama3.1)",
                  "default": "llama3.1"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          {
            "name": "ollama_generate",
            "description": "Generate text completions using Ollama models with configurable parameters.",
            "title": "Generate Text",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the model to use for generation"
                },
                "prompt": {
                  "type": "string",
                  "description": "The prompt to generate text from"
                },
                "options": {
                  "type": "object",
                  "description": "Generation options (temperature, top_p, etc.)",
                  "properties": {
                    "temperature": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "top_p": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "top_k": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "num_predict": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "repeat_penalty": {
                      "type": "number",
                      "minimum": 0
                    },
                    "seed": {
                      "type": "integer"
                    },
                    "stop": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model",
                "prompt"
              ],
              "type": "object"
            }
          },
          {
            "name": "ollama_list",
            "description": "List all available Ollama models installed locally. Returns model names, sizes, and modification dates.",
            "title": "List Models",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "type": "object"
            }
          },
          {
            "name": "ollama_ps",
            "description": "List all currently running/loaded models in Ollama, showing memory usage and runtime information.",
            "title": "List Running Models",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "type": "object"
            }
          },
          {
            "name": "ollama_pull",
            "description": "Download and install models from the Ollama library to your local machine.",
            "title": "Pull Model",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": false
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the model to pull (e.g., 'llama3.2', 'mistral', 'codellama')"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model"
              ],
              "type": "object"
            }
          },
          {
            "name": "ollama_show",
            "description": "Get detailed information about a specific Ollama model including size, parameters, and capabilities.",
            "title": "Show Model Details",
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "inputSchema": {
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Name of the model to show information for"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "markdown"
                  ],
                  "description": "Output format (default: json)",
                  "default": "json"
                }
              },
              "required": [
                "model"
              ],
              "type": "object"
            }
          }
        ],
        "prompts": [
          {
            "name": "explain_lora",
            "description": "Explain LoRA (Low-Rank Adaptation) technique"
          },
          {
            "name": "code_review",
            "description": "Review code and provide feedback"
          },
          {
            "name": "hello_world",
            "description": "Generate Hello World code in any language"
          },
          {
            "name": "explain_code",
            "description": "Explain what a code snippet does in detail"
          },
          {
            "name": "write_docstring",
            "description": "Generate comprehensive docstring/documentation for code"
          }
        ],
        "resources": [
          {
            "name": "Available Models",
            "description": "List of all available Ollama models",
            "uri": "ollama://models"
          },
          {
            "name": "Running Models",
            "description": "List of currently running models",
            "uri": "ollama://running"
          },
          {
            "name": "Ollama Configuration",
            "description": "Current Ollama server configuration",
            "uri": "ollama://config"
          }
        ]
      }
    }
  }
}
